# Copy to .env.local and fill in real values:
#   cp .env.example .env.local
# Vite only exposes vars prefixed with VITE_ to the client.
# Restart `npm run dev` after editing.

# Supabase project URL — Supabase Dashboard > Project Settings > API > Project URL
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anon/public key (safe for the browser; NEVER use the service_role key here)
VITE_SUPABASE_ANON_KEY=your-anon-public-key
